# infra/stacks/platform/management/main.tf
# Entry point for the Management platform stack.
# Deploys the management resource group that hosts Log Analytics and Defender.
# Provider alias "azurerm.management" is generated by terragrunt.hcl.

locals {
  # Mandatory tags merged with any additional tags from env.hcl
  mandatory_tags = merge(var.tags, {
    Project     = var.name_prefix
    Environment = var.environment
    ManagedBy   = "terraform"
  })
}

module "resource_group" {
  source = "../../../modules/resource-group"

  providers = {
    azurerm = azurerm.management
  }

  name_prefix = var.name_prefix
  environment = var.environment
  location    = var.location
  tags        = local.mandatory_tags
}
