# =============================================================================
# infra/stacks/platform/connectivity/main.tf
# Hub Resource Group — always deployed as the foundation of the connectivity stack.
# Provider alias "azurerm.connectivity" is generated by terragrunt.hcl.
# =============================================================================

module "resource_group" {
  source = "../../../modules/resource-group"

  providers = {
    azurerm = azurerm.connectivity
  }

  name_prefix = var.name_prefix
  environment = var.environment
  location    = var.location
  tags        = merge(var.tags, {
    Project     = var.name_prefix
    Environment = var.environment
    ManagedBy   = "terraform"
  })
}
