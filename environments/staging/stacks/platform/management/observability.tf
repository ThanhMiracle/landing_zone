# infra/stacks/platform/management/observability.tf
# Observability resources: Log Analytics Workspace and optional Defender for Cloud.
# All resources use provider alias "azurerm.management" (generated by terragrunt.hcl).

module "log_analytics" {
  source = "../../../modules/log-analytics"

  providers = {
    azurerm = azurerm.management
  }

  name_prefix         = var.name_prefix
  environment         = var.environment
  location            = var.location
  resource_group_name = module.resource_group.name
  retention_in_days   = var.log_analytics_retention_days
  tags                = local.mandatory_tags
}

module "defender" {
  source = "../../../modules/defender-for-cloud"
  count  = var.deploy_defender ? 1 : 0

  providers = {
    azurerm = azurerm.management
  }
}
