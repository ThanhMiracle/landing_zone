# =============================================================================
# infra/stacks/application/baseline/main.tf
#
# Baseline application stack — deploys the foundational spoke infrastructure:
#   - Resource Group
#   - (networking.tf) Spoke VNet, NSG, VNet Peering, Route Table
#   - (compute.tf)    Managed Identity
#   - (database.tf)   Key Vault
#
# Provider aliases (generated by Terragrunt into provider_generated.tf):
#   azurerm.workload     — app subscription (all baseline resources)
#   azurerm.connectivity — connectivity subscription (hub-side VNet peering)
#
# NOTE: No provider {} or terraform {} block here.
#       These are auto-generated by root terragrunt.hcl and the stack's
#       generate "provider" block into provider_generated.tf.
# =============================================================================

# ---------------------------------------------------------------------------
# Data source — current Azure client config (tenant ID for Key Vault)
# ---------------------------------------------------------------------------
data "azurerm_client_config" "current" {
  provider = azurerm.workload
}

# ---------------------------------------------------------------------------
# Resource Group
# ---------------------------------------------------------------------------
module "resource_group" {
  source    = "../../../modules/resource-group"
  providers = { azurerm = azurerm.workload }

  name_prefix = var.name_prefix
  environment = var.environment
  location    = var.location
  tags = merge(var.tags, {
    Project     = var.name_prefix
    Environment = var.environment
    ManagedBy   = "terraform"
  })
}
