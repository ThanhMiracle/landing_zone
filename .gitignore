# Terraform state files
*.tfstate
*.tfstate.*

# Terraform working directory
.terraform/

# Crash log
crash.log
crash.*.log

# Override files (not meant to be version controlled)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# tfvars may contain sensitive data — exclude all except examples
*.tfvars
!*.tfvars.example

# Terraform lock file — generated by `terraform init`, not to be committed
# Note: *.lock.hcl matches only lock files; env.hcl and terragrunt.hcl are NOT excluded
*.lock.hcl

# Terragrunt generated files — auto-created by `generate` blocks, not to be committed
backend.tf
provider_generated.tf

# Terragrunt working directory
.terragrunt-cache/
.terragrunt-cache-*
draft.MD
THANH_SYSTEM_RUNBOOK.md